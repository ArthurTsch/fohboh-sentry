generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model managers {
  id                  Int       @id @default(autoincrement())
  email               String    @unique @db.VarChar(255)
  password_hash       String    @db.VarChar(255)
  role                String    @db.VarChar(50)
  active              Boolean?  @default(true)
  email_verified      Boolean?  @default(false)
  full_name           String?   @db.VarChar(100)
  phone_number        String?   @db.VarChar(20)
  address             String?
  profile_image       String?   @db.VarChar(255)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  created_by          Int?
  regional_manager_id Int?
}

model restaurants {
  id             Int       @id @default(autoincrement())
  store_id       String?   @db.VarChar(255)
  name           String    @db.VarChar(255)
  location       String?
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  zip_code       String?   @db.VarChar(20)
  country        String?   @db.VarChar(100)
  contact_number String?   @db.VarChar(50)
  created_by     Int?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  active         Boolean?  @default(true)
  unit_id        String?   @unique @db.VarChar(50)

  @@index([created_by], map: "idx_restaurants_created_by")
  @@index([name], map: "idx_restaurants_name")
  @@index([store_id], map: "idx_restaurants_store_id")
}

model caar_reports {
  id             Int       @id @default(autoincrement())
  caar_id        String    @unique @db.VarChar(100)
  account_id     String?   @db.VarChar(255)
  restaurant_id  Int?
  created_by     Int?
  location_id    String    @db.VarChar(100)
  location_name  String    @db.VarChar(255)
  period         String    @db.VarChar(100)
  trust_score    Int
  amount_cents   Int
  amount_display String    @db.VarChar(50)
  status         String    @db.VarChar(50)
  exhibits       Int?      @default(0)
  narrative      String
  findings       Json
  dimensions     Json
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([account_id], map: "idx_caar_reports_account_id")
  @@index([created_by], map: "idx_caar_reports_created_by")
  @@index([location_id], map: "idx_caar_reports_location_id")
  @@index([restaurant_id], map: "idx_caar_reports_restaurant_id")
}

model restaurant_sentry_state {
  id                  Int       @id @default(autoincrement())
  restaurant_id       Int       @unique
  location_id         String    @unique @db.VarChar(100)
  account_id          String?   @db.VarChar(255)
  created_by          Int?
  status              String    @default("Onboarding") @db.VarChar(50)
  m01_score           Int       @default(0)
  m02_score           Int       @default(0)
  ium                 String?   @default("--") @db.VarChar(50)
  recovery_display    String?   @default("$0") @db.VarChar(50)
  last_certified      String?   @default("Pending") @db.VarChar(50)
  modules_json        Json?
  onboarding_progress Json?
  onboarding_checklist Json?
  completed           Boolean?  @default(false)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  @@index([account_id], map: "idx_restaurant_sentry_state_account_id")
  @@index([created_by], map: "idx_restaurant_sentry_state_created_by")
}

model customers {
  id             Int       @id @default(autoincrement())
  name           String
  plan           String    @default("wgs") @db.VarChar(50)
  cortex_enabled Boolean   @default(false)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  @@index([name], map: "idx_customers_name")
}

model users {
  id            Int       @id @default(autoincrement())
  customer_id   Int?
  auth0_sub     String    @unique
  email         String
  display_name  String
  role          String    @db.VarChar(50)
  active        Boolean   @default(true)
  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([customer_id], map: "idx_users_customer_id")
  @@index([email], map: "idx_users_email")
}

model locations_v2 {
  id           Int       @id @default(autoincrement())
  customer_id  Int
  external_id  String
  name         String
  address      String?
  pos_system   String?   @db.VarChar(50)
  status       String    @default("onboarding") @db.VarChar(50)
  activated_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  @@unique([customer_id, external_id], map: "uq_locations_v2_customer_external_id")
  @@index([customer_id, status], map: "idx_locations_v2_customer_status")
  @@map("locations_v2")
}

model location_modules {
  id           Int       @id @default(autoincrement())
  location_id  Int
  module       String    @db.VarChar(10)
  status       String    @default("pending") @db.VarChar(50)
  activated_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([location_id, module], map: "uq_location_modules_location_module")
  @@index([location_id], map: "idx_location_modules_location_id")
}

model contract_configs_v2 {
  id          Int       @id @default(autoincrement())
  location_id Int
  module      String    @db.VarChar(10)
  version     Int
  terms       Json
  sealed_by   Int
  sealed_at   DateTime? @default(now()) @db.Timestamptz(6)
  sha256      String    @db.Char(64)
  prev_sha256 String?   @db.Char(64)

  @@unique([location_id, module, version], map: "uq_contract_configs_v2_location_module_version")
  @@index([location_id, module, version], map: "idx_contract_configs_v2_location_module_version")
  @@map("contract_configs_v2")
}

model schema_registry_v2 {
  id          Int       @id @default(autoincrement())
  location_id Int
  module      String    @db.VarChar(10)
  vendor      String    @db.VarChar(100)
  version     Int
  fields      Json
  sealed_by   Int
  sealed_at   DateTime? @default(now()) @db.Timestamptz(6)
  sha256      String    @db.Char(64)

  @@unique([location_id, module, vendor, version], map: "uq_schema_registry_v2_location_module_vendor_version")
  @@index([location_id, module, vendor, version], map: "idx_schema_registry_v2_location_module_vendor_version")
  @@map("schema_registry_v2")
}

model uploads_v2 {
  id            Int       @id @default(autoincrement())
  location_id   Int
  module        String    @db.VarChar(10)
  file_purpose  String    @db.VarChar(100)
  vendor        String?   @db.VarChar(100)
  file_name     String
  s3_key        String
  byte_count    BigInt
  row_count     Int?
  page_count    Int?
  sha256        String    @db.Char(64)
  uploaded_by   Int
  uploaded_at   DateTime? @default(now()) @db.Timestamptz(6)
  superseded_by Int?

  @@index([location_id, module], map: "idx_uploads_v2_location_module")
  @@index([sha256], map: "idx_uploads_v2_sha256")
  @@map("uploads_v2")
}

model cert_runs_v2 {
  id                  Int       @id @default(autoincrement())
  location_id         Int
  module              String    @db.VarChar(10)
  period              String    @db.VarChar(50)
  contract_config_id  Int
  schema_registry_ids Json
  upload_ids          Json
  rule_set_version    String    @db.VarChar(100)
  status              String    @default("queued") @db.VarChar(50)
  started_at          DateTime? @db.Timestamptz(6)
  completed_at        DateTime? @db.Timestamptz(6)
  trust_score         Int?
  variance_cents      BigInt?
  triggered_by        Int
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  error_message       String?

  @@index([location_id, module, period], map: "idx_cert_runs_v2_location_module_period")
  @@index([status], map: "idx_cert_runs_v2_status")
  @@map("cert_runs_v2")
}

model caars_v2 {
  id                         Int       @id @default(autoincrement())
  caar_external_id           String    @unique
  cert_run_id                Int       @unique
  location_id                Int
  module                     String    @db.VarChar(10)
  period                     String    @db.VarChar(50)
  status                     String    @db.VarChar(50)
  court_admissible           Boolean   @default(false)
  trust_score                Int
  finding_class              String    @db.VarChar(100)
  recoverable_variance_cents BigInt
  canonical_payload_s3_key   String
  pdf_s3_key                 String?
  exportpack_s3_key          String?
  sha256                     String    @db.Char(64)
  prev_sha256                String?   @db.Char(64)
  sealed_at                  DateTime? @default(now()) @db.Timestamptz(6)
  superseded_by              Int?
  superseded_reason          String?

  @@index([location_id, sealed_at], map: "idx_caars_v2_location_sealed_at")
  @@index([status], map: "idx_caars_v2_status")
  @@index([caar_external_id], map: "idx_caars_v2_external_id")
  @@map("caars_v2")
}

model caar_artifacts_v2 {
  id            Int       @id @default(autoincrement())
  caar_id       Int
  seq           Int
  artifact_type String    @db.VarChar(100)
  name          String
  s3_key        String
  byte_count    BigInt
  sha256        String    @db.Char(64)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([caar_id, seq], map: "uq_caar_artifacts_v2_caar_seq")
  @@map("caar_artifacts_v2")
}

model rule_citations_v2 {
  id              Int       @id @default(autoincrement())
  cert_run_id     Int
  rule_id         String    @db.VarChar(100)
  rule_version    String    @db.VarChar(50)
  fired_count     Int       @default(0)
  variance_cents  BigInt    @default(0)
  sample_evidence Json?

  @@unique([cert_run_id, rule_id], map: "uq_rule_citations_v2_cert_run_rule")
  @@index([cert_run_id], map: "idx_rule_citations_v2_cert_run_id")
  @@index([rule_id], map: "idx_rule_citations_v2_rule_id")
  @@map("rule_citations_v2")
}

model mq6_scores_v2 {
  id           Int       @id @default(autoincrement())
  cert_run_id  Int
  dimension    String    @db.VarChar(50)
  score        Int
  weight_bps   Int
  evidence     Json?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([cert_run_id, dimension], map: "uq_mq6_scores_v2_cert_run_dimension")
  @@index([cert_run_id], map: "idx_mq6_scores_v2_cert_run_id")
  @@map("mq6_scores_v2")
}

model audit_log_v2 {
  id            Int       @id @default(autoincrement())
  customer_id   Int?
  location_id   Int?
  actor_user_id Int?
  action        String
  entity_type   String    @db.VarChar(100)
  entity_id     String    @db.VarChar(100)
  summary       String
  metadata      Json?
  ip_address    String?   @db.VarChar(64)
  user_agent    String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([customer_id], map: "idx_audit_log_v2_customer_id")
  @@index([location_id], map: "idx_audit_log_v2_location_id")
  @@index([actor_user_id], map: "idx_audit_log_v2_actor_user_id")
  @@index([entity_type, entity_id], map: "idx_audit_log_v2_entity")
  @@map("audit_log_v2")
}

model store_analytics_results {
  id               Int       @id @default(autoincrement())
  store_id         String    @db.VarChar(50)
  time_period      String    @db.VarChar(50)
  analytics_data   Json
  calculation_date DateTime  @db.Date
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  email            String?   @db.VarChar(255)

  @@unique([store_id, time_period, calculation_date])
  @@index([calculation_date], map: "idx_analytics_date")
  @@index([time_period], map: "idx_analytics_period")
  @@index([store_id], map: "idx_analytics_store_id")
}

model store_credentials {
  id            Int       @id @default(autoincrement())
  store_id      String    @db.VarChar(255)
  client_id     String    @db.VarChar(255)
  client_secret String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  email         String?   @db.VarChar(255)
  cid           String?   @db.VarChar(255)

  @@unique([store_id, email])
}

model store_embeddings {
  id            Int       @id @default(autoincrement())
  store_id      String    @db.VarChar(50)
  data_type     String    @db.VarChar(50)
  record_id     String?   @db.VarChar(255)
  data_hash     String    @db.VarChar(255)
  chunk_index   Int?      @default(0)
  text_content  String
  embedding     Float[]
  original_data Json?
  record_date   DateTime? @db.Date
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([data_type], map: "idx_embeddings_data_type")
  @@index([record_date], map: "idx_embeddings_date")
  @@index([data_hash], map: "idx_embeddings_hash")
  @@index([record_id], map: "idx_embeddings_record_id")
  @@index([store_id], map: "idx_embeddings_store_id")
}

model store_employees {
  id               Int       @id @default(autoincrement())
  store_id         String    @db.VarChar(50)
  employee_id      String?   @db.VarChar(100)
  name             String?   @db.VarChar(255)
  role             String?   @db.VarChar(100)
  hire_date        DateTime? @db.Date
  termination_date DateTime? @db.Date
  hourly_rate      Decimal?  @db.Decimal
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([store_id], map: "idx_employees_store_id")
}

model store_inventory {
  id             Int       @id @default(autoincrement())
  store_id       String    @db.VarChar(50)
  inventory_date DateTime? @db.Date
  ingredient     String?   @db.VarChar(255)
  quantity       Decimal?  @db.Decimal
  par_level      Decimal?  @db.Decimal
  unit_cost      Decimal?  @db.Decimal
  is_low         Boolean?
  waste          Decimal?  @default(0) @db.Decimal
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([inventory_date], map: "idx_inventory_date")
  @@index([store_id], map: "idx_inventory_store_id")
}

model store_menu {
  id         Int       @id @default(autoincrement())
  store_id   String    @db.VarChar(50)
  menu_item  String?   @db.VarChar(255)
  ingredient String?   @db.VarChar(255)
  amount     Decimal?  @db.Decimal
  unit_cost  Decimal?  @db.Decimal
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([store_id], map: "idx_menu_store_id")
}

model store_sales {
  id                  Int       @id @default(autoincrement())
  store_id            String    @db.VarChar(50)
  sale_id             String?   @db.VarChar(100)
  sale_date           DateTime? @db.Date
  sale_time           DateTime? @db.Timestamp(6)
  sold_items_name     String?
  number_of_items     Decimal?  @db.Decimal
  subtotal            Decimal?  @db.Decimal
  tip                 Decimal?  @db.Decimal
  total_amount        Decimal?  @db.Decimal
  payment_method      String?   @db.VarChar(255)
  order_type          String?   @db.VarChar(100)
  customer_id         String?   @db.VarChar(100)
  is_loyalty          Boolean?
  promotion_id        String?   @db.VarChar(100)
  discount_applied    Decimal?  @db.Decimal
  table_number        String?   @db.VarChar(50)
  guest_count         Int?
  seated_time         DateTime? @db.Timestamp(6)
  departure_time      DateTime? @db.Timestamp(6)
  was_reservation     Boolean?
  order_received_time DateTime? @db.Timestamp(6)
  kitchen_start_time  DateTime? @db.Timestamp(6)
  had_modification    Boolean?
  order_accuracy      Decimal?  @db.Decimal
  void_status         Boolean?  @default(false)
  reason              String?
  daypart             String?   @db.VarChar(50)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  @@unique([store_id, sale_id], map: "uq_store_sales_store_sale")
  @@index([sale_date], map: "idx_sales_date")
  @@index([store_id], map: "idx_sales_store_id")
}

model text_notes {
  id         String    @id @db.VarChar(36)
  user_email String    @db.VarChar(255)
  content    Json
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_email])
}
